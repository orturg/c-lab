<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MauiUI.ViewModels"
             x:Class="MauiUI.Pages.AddEditProductPage"
             x:DataType="viewmodels:AddEditProductViewModel"
             Title="{Binding PageTitle}">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,12" Spacing="16">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Назва товару" FontAttributes="Bold" />
                    <Entry Text="{Binding Name}" Placeholder="Введіть назву" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Категорія" FontAttributes="Bold" />
                    <Picker ItemsSource="{Binding CategoryOptions}"
                            SelectedIndex="{Binding SelectedCategoryIndex}" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Кількість (шт.)" FontAttributes="Bold" />
                        <Entry Text="{Binding QuantityText}" Keyboard="Numeric"
                               Placeholder="0" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Ціна (грн)" FontAttributes="Bold" />
                        <Entry Text="{Binding PriceText}" Keyboard="Numeric"
                               Placeholder="0.00" />
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Опис" FontAttributes="Bold" />
                    <Editor Text="{Binding Description}" Placeholder="Введіть опис"
                            MinimumHeightRequest="100" AutoSize="TextChanges" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8" Margin="16,8">
            <Button Grid.Column="0" Text="Скасувати"
                    Command="{Binding CancelCommand}" />
            <Button Grid.Column="1" Text="Зберегти"
                    Command="{Binding SaveCommand}" />
        </Grid>

        <ActivityIndicator Grid.RowSpan="2"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center" VerticalOptions="Center" />

        <Grid Grid.RowSpan="2" IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000" InputTransparent="False" />

    </Grid>

</ContentPage>
