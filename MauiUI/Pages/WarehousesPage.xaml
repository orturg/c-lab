<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dto="clr-namespace:Lab1.Services.DTO;assembly=Lab1.Services"
             xmlns:viewmodels="clr-namespace:MauiUI.ViewModels"
             x:Class="MauiUI.Pages.WarehousesPage"
             x:DataType="viewmodels:WarehousesViewModel"
             Title="Склади">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <SearchBar Grid.Row="0" Placeholder="Пошук складу..."
                   Text="{Binding SearchText}" Margin="8,8,8,0" />

        <Picker Grid.Row="1" SelectedIndex="{Binding SortIndex}" Margin="8,4">
            <Picker.Items>
                <x:String>За назвою (А–Я)</x:String>
                <x:String>За назвою (Я–А)</x:String>
                <x:String>За містом (А–Я)</x:String>
                <x:String>За містом (Я–А)</x:String>
            </Picker.Items>
        </Picker>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding FilteredWarehouses}"
                        SelectionMode="None"
                        Margin="8,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:WarehouseListDto">
                    <Grid ColumnDefinitions="*,Auto" Padding="8,12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:WarehousesViewModel}}, Path=SelectWarehouseCommand}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" />
                            <Label Text="{Binding LocationDisplay}" FontSize="13" TextColor="Gray" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1" Text="✕" TextColor="Red"
                                BackgroundColor="Transparent" FontSize="18"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:WarehousesViewModel}}, Path=DeleteWarehouseCommand}"
                                CommandParameter="{Binding .}" />

                        <BoxView Grid.ColumnSpan="2" HeightRequest="1"
                                 Color="LightGray" VerticalOptions="End" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="3" Text="+ Додати склад"
                Command="{Binding AddWarehouseCommand}"
                Margin="16,8" HorizontalOptions="Fill" />

        <ActivityIndicator Grid.RowSpan="4"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center" VerticalOptions="Center" />

        <Grid Grid.RowSpan="4" IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000" InputTransparent="False" />

    </Grid>

</ContentPage>
