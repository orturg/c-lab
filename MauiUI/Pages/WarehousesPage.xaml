<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dto="clr-namespace:Lab1.Services.DTO;assembly=Lab1.Services"
             x:Class="MauiUI.Pages.WarehousesPage"
             Title="Склади">

    <CollectionView ItemsSource="{Binding Warehouses}"
                    SelectionMode="Single"
                    SelectionChangedCommand="{Binding SelectWarehouseCommand}"
                    SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}}"
                    Margin="16,8">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="dto:WarehouseListDto">
                <VerticalStackLayout Padding="0,12" Spacing="2">
                    <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" />
                    <Label Text="{Binding LocationDisplay}" FontSize="13" TextColor="Gray" />
                    <BoxView HeightRequest="1" Color="LightGray" Margin="0,10,0,0" />
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>