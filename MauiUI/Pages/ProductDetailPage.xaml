<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MauiUI.ViewModels"
             x:Class="MauiUI.Pages.ProductDetailPage"
             x:DataType="viewmodels:ProductDetailViewModel"
             Title="Деталі товару">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,12" Spacing="10">

                <Label Text="{Binding Product.Name}" FontSize="18" FontAttributes="Bold" />

                <BoxView HeightRequest="1" Color="LightGray" />

                <Grid ColumnDefinitions="130,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Категорія:" FontAttributes="Bold" FontSize="14" />
                    <Label Grid.Column="1" Text="{Binding Product.CategoryDisplay}" FontSize="14" />
                </Grid>

                <Grid ColumnDefinitions="130,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Кількість:" FontAttributes="Bold" FontSize="14" />
                    <Label Grid.Column="1"
                           Text="{Binding Product.Quantity, StringFormat='{0} шт.'}" FontSize="14" />
                </Grid>

                <Grid ColumnDefinitions="130,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Ціна за од.:" FontAttributes="Bold" FontSize="14" />
                    <Label Grid.Column="1"
                           Text="{Binding Product.UnitPrice, StringFormat='{0:N2} грн'}" FontSize="14" />
                </Grid>

                <Grid ColumnDefinitions="130,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Загальна:" FontAttributes="Bold" FontSize="14" />
                    <Label Grid.Column="1"
                           Text="{Binding Product.TotalValue, StringFormat='{0:N2} грн'}" FontSize="14" />
                </Grid>

                <BoxView HeightRequest="1" Color="LightGray" />

                <Label Text="Опис:" FontAttributes="Bold" FontSize="14" />
                <Label Text="{Binding Product.Description}" FontSize="14" />

            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="1" Text="Редагувати товар"
                Command="{Binding EditProductCommand}"
                Margin="16,8" HorizontalOptions="Fill" />

        <ActivityIndicator Grid.RowSpan="2"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center" VerticalOptions="Center" />

    </Grid>

</ContentPage>
