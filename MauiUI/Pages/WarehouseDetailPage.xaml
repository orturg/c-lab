<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dto="clr-namespace:Lab1.Services.DTO;assembly=Lab1.Services"
             xmlns:viewmodels="clr-namespace:MauiUI.ViewModels"
             x:Class="MauiUI.Pages.WarehouseDetailPage"
             x:DataType="viewmodels:WarehouseDetailViewModel"
             Title="Деталі складу">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <VerticalStackLayout Grid.Row="0" Padding="16,12,16,8" Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="{Binding Warehouse.Name}" FontSize="18" FontAttributes="Bold" />
                    <Label Text="{Binding Warehouse.LocationDisplay, StringFormat='Місто: {0}'}"
                           FontSize="14" TextColor="Gray" />
                    <Label Text="{Binding Warehouse.TotalValue, StringFormat='Загальна вартість: {0:N2} грн'}"
                           FontSize="14" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Редагувати"
                        Command="{Binding EditWarehouseCommand}"
                        VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>

        <BoxView Grid.Row="1" HeightRequest="1" Color="LightGray" Margin="16,0" />

        <Label Grid.Row="2" Text="Товари" FontSize="16" FontAttributes="Bold"
               Margin="16,8,16,0" />

        <VerticalStackLayout Grid.Row="3" Margin="8,4">
            <SearchBar Placeholder="Пошук товару..."
                       Text="{Binding SearchText}" />
            <Picker SelectedIndex="{Binding SortIndex}">
                <Picker.Items>
                    <x:String>За назвою (А–Я)</x:String>
                    <x:String>За назвою (Я–А)</x:String>
                    <x:String>За ціною (зрост.)</x:String>
                    <x:String>За ціною (спад.)</x:String>
                    <x:String>За кількістю (зрост.)</x:String>
                    <x:String>За кількістю (спад.)</x:String>
                </Picker.Items>
            </Picker>

        </VerticalStackLayout>

        <CollectionView Grid.Row="4"
                        ItemsSource="{Binding FilteredProducts}"
                        SelectionMode="None"
                        Margin="8,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:ProductListDto">
                    <Grid ColumnDefinitions="*,Auto" Padding="8,12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:WarehouseDetailViewModel}}, Path=SelectProductCommand}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding CategoryDisplay}"
                                       FontSize="13" TextColor="Gray" />
                                <Label Grid.Column="1"
                                       Text="{Binding UnitPrice, StringFormat='{0:N2} грн'}"
                                       FontSize="13" />
                            </Grid>
                            <Label Text="{Binding Quantity, StringFormat='Кількість: {0} шт.'}"
                                   FontSize="13" TextColor="Gray" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1" Text="✕" TextColor="Red"
                                BackgroundColor="Transparent" FontSize="18"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:WarehouseDetailViewModel}}, Path=DeleteProductCommand}"
                                CommandParameter="{Binding .}" />

                        <BoxView Grid.ColumnSpan="2" HeightRequest="1"
                                 Color="LightGray" VerticalOptions="End" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="5" Text="+ Додати товар"
                Command="{Binding AddProductCommand}"
                Margin="16,8" HorizontalOptions="Fill" />

        <ActivityIndicator Grid.RowSpan="6"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center" VerticalOptions="Center" />

        <Grid Grid.RowSpan="6" IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000" InputTransparent="False" />

    </Grid>

</ContentPage>
