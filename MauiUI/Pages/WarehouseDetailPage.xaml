<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dto="clr-namespace:Lab1.Services.DTO;assembly=Lab1.Services"
             x:Class="MauiUI.Pages.WarehouseDetailPage"
             Title="Деталі складу">

    <ScrollView>
        <VerticalStackLayout Padding="16,12" Spacing="4">

            <Label Text="{Binding Warehouse.Name, StringFormat='Склад: {0}'}"
                   FontSize="18" FontAttributes="Bold" />
            <Label Text="{Binding Warehouse.LocationDisplay, StringFormat='Місто: {0}'}"
                   FontSize="14" TextColor="Gray" />
            <Label Text="{Binding Warehouse.TotalValue, StringFormat='Загальна вартість: {0:N2} грн'}"
                   FontSize="14" />

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,12" />
            <Label Text="Товари" FontSize="16" FontAttributes="Bold" Margin="0,0,0,4" />

            <CollectionView ItemsSource="{Binding Warehouse.Products}"
                            SelectionMode="Single"
                            SelectionChangedCommand="{Binding SelectProductCommand}"
                            SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:ProductListDto">
                        <VerticalStackLayout Padding="0,10" Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding Name}"
                                       FontSize="15" FontAttributes="Bold" />
                                <Label Grid.Column="1"
                                       Text="{Binding UnitPrice, StringFormat='{0:N2} грн'}"
                                       FontSize="15" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding CategoryDisplay}"
                                       FontSize="13" TextColor="Gray" />
                                <Label Grid.Column="1"
                                       Text="{Binding Quantity, StringFormat='{0} шт.'}"
                                       FontSize="13" TextColor="Gray" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="LightGray" Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
